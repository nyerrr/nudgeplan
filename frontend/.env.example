# Point the app at your FastAPI backend.
# Local development only. Remote/device deployments must use an HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:8001
# Optional, local development only. Matches backend API_AUTH_TOKEN when that
# is set. Deployed builds authenticate with the signed-in user's Supabase
# token instead, so leave this empty for the APK - anything here ships in the
# bundle and is readable by anyone.
EXPO_PUBLIC_API_KEY=

# Supabase Auth. When both values are present, Google and email sign-in use
# Supabase and the app stops showing preview/demo notices.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
