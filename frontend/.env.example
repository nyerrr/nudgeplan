# Point the app at your FastAPI backend.
# Local development only. Remote/device deployments must use an HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:8001
# Must match backend API_AUTH_TOKEN when authentication is enabled.
EXPO_PUBLIC_API_KEY=

# Login is currently in preview/demo mode. When you connect Supabase Auth,
# add the project URL and anon key here and swap the demo adapter in
# src/lib/auth.ts for the Supabase implementation.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
