# Point the app at your FastAPI backend.
# Local development only. Remote/device deployments must use an HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:8001
# Must match backend API_AUTH_TOKEN when authentication is enabled.
EXPO_PUBLIC_API_KEY=

# Supabase Auth. When both values are present, Google and email sign-in use
# Supabase and the app stops showing preview/demo notices.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
