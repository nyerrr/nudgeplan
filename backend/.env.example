GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini models (https://ai.google.dev/gemini-api/docs/models):
#   gemini-2.5-flash      -> NOT available to new API keys (returns 404)
#   gemini-2.0-flash      -> shut down 2026-06-01
#   gemini-3.5-flash-lite -> fastest and cheapest; good default for a quick UI
#   gemini-3.6-flash      -> reliable, good quality, occasionally slower
#   gemini-3.8-flash      -> best quality, but often 503 under high demand
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.8-flash

# Set to true to use the built-in offline planner (no API key needed).
# Remove or set to false once you add a real GEMINI_API_KEY.
GEMINI_MOCK=false

# Backend port. 8001 is the default so that local AI tooling does not
# mistake this service for an OpenAI-compatible LLM server on port 8000.
PORT=8001

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional static key for local/self-hosted use when Supabase is not configured.
# Keep this secret. It is ignored whenever SUPABASE_URL is also set, so it can
# never bypass real user authentication.
API_AUTH_TOKEN=

# Supabase project used to verify user access tokens on /ai/* and /plan/*.
# Supabase dashboard -> Project Settings -> API.
# When SUPABASE_URL is set, a signed-in user's token is required (see auth.py).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Set to false only to deliberately leave the AI endpoints open (local dev).
AUTH_REQUIRED=true

# Swagger docs are hidden automatically when Supabase auth is enabled.
# Uncomment to force them on (useful for a private staging instance).
# ENABLE_DOCS=false

# In-process AI abuse guard. Set AI_RATE_LIMIT=0 to disable (not recommended).
AI_RATE_LIMIT=30
AI_RATE_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=65536

# Bind to 127.0.0.1 for local development. Use a TLS reverse proxy for remote access.
HOST=127.0.0.1
